# Copy to .env and fill in the values marked change-me.

# Database (docker-compose overrides DB_HOST with the service name "db")
DB_HOST=db
DB_PORT=5432
DB_NAME=finance
DB_USER=my_finance_mcp
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# Same Fernet key used by my-finance to encrypt the data
FERNET_KEY=change-me

# Personal tokens (secret must have at least 32 bytes)
MCP_TOKEN_SECRET=change-me
MCP_TOKEN_ISSUER=my-finance-mcp
MCP_TOKEN_MAX_DAYS=90

# Public address of the MCP endpoint, kept exactly as written
MCP_PUBLIC_URL=https://finance-mcp.<tailnet>.ts.net/mcp
# Origin of MCP_PUBLIC_URL; this is also the value used when the key is absent
MCP_AUTH_ISSUER_URL=https://finance-mcp.<tailnet>.ts.net
# Comma-separated lists
MCP_ALLOWED_HOSTS=finance-mcp.<tailnet>.ts.net
MCP_ALLOWED_ORIGINS=

RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# Tracing (OTEL_EXPORTER_OTLP_ENDPOINT is required when TRACING_ENABLED=true)
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
